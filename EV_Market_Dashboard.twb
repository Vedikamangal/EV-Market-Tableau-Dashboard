                <format attr='border-width' value='0' />
                <format attr='margin' value='8' />
              </zone-style>
            </zone>
          </zones>
        </devicelayout>
      </devicelayouts>
      <simple-id uuid='{4F55EE6F-A643-48E1-9919-9FFD34853504}' />
    </dashboard>
